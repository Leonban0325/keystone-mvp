# Server-side ONLY (consumed by /api/* functions and npm run seed).
# NEVER prefix these with VITE_ — anything VITE_ is bundled into client JS
# and publicly readable on the deployed URL.

# Anthropic key for live lease extraction + natural-language query.
# Optional: without it every AI endpoint falls back to canned output.
ANTHROPIC_API_KEY=

# Hosted Postgres (Neon / Supabase / Vercel Postgres) connection string.
# Optional: without it the back-end uses PGlite, an embedded Postgres
# persisted to .data/ locally — zero accounts, works fully offline.
DATABASE_URL=
