      "params": {
        "monthsConforming": 1,
        "monthsNonConforming": 2,
        "penalty": {
          "type": "percent_of_monthly_rent_per_commenced_month",
          "percent": 10
        }
      }
    },
    {
      "id": "FR-DEP-INTEREST",
      "check": "tenant_interest",
      "severity": "info",
      "legal_ref": "Loi 89-462, art. 22 (silent — no statutory remuneration)",
